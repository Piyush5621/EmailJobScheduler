# Application
PORT=3000
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# PostgreSQL
DATABASE_URL=postgresql://emailscheduler_user:local_dev_password@localhost:5432/emailscheduler

# Redis & Sessions
REDIS_URL=redis://localhost:6379
SESSION_SECRET=your_session_secret_key_here

# Ethereal / SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password_here

# Worker Configuration
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=100

# Slack Integration (OAuth v2)
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:3000/integrations/slack/callback
